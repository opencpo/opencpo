# OCPP Platform — Environment Configuration
# Copy this file to .env and adjust for your environment.
# All defaults work for local development.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=ocpp
POSTGRES_USER=ocpp
POSTGRES_PASSWORD=ocpp           # CHANGE THIS IN PRODUCTION
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── ocpp-core (CSMS Backend) ──────────────────────────────────────────────────
OCPP_16_WS_PORT=9100             # OCPP 1.6 WebSocket port
OCPP_201_WS_PORT=9201            # OCPP 2.0.1 WebSocket port
OCPP_API_PORT=8000               # REST API port

# Secret key for JWT signing — CHANGE THIS IN PRODUCTION
SECRET_KEY=change-me-in-production

# Log level: debug | info | warning | error
LOG_LEVEL=info

# ── ocpp-cpo-admin (Operator Dashboard) ──────────────────────────────────────
CPO_ADMIN_PORT=8080

# Your organisation name shown in the UI and reports
ORG_NAME=My CPO

# ── ocpp-charge-app (Driver PWA) ──────────────────────────────────────────────
CHARGE_APP_PORT=8003

# ── ocpp-compliance-tester ────────────────────────────────────────────────────
COMPLIANCE_PORT=8090

# ── ocpp-charger-farm (Simulator) ─────────────────────────────────────────────
CHARGER_FARM_PORT=8087

# ── Shared ────────────────────────────────────────────────────────────────────
# Public base URL — used for QR code generation and email links.
# For local dev: http://localhost
# For production: https://charging.example.com
PUBLIC_URL=http://localhost
