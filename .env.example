# ═══════════════════════════════════════════════════════════════════════════════
# OpenCPO Platform — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and adjust for your deployment:
#   cp .env.example .env
#
# All default values work for local development.  For production you MUST
# change POSTGRES_PASSWORD and SECRET_KEY at minimum.
#
# Use the interactive configuration wizard to set up your environment:
#   python configure.py
#
# ═══════════════════════════════════════════════════════════════════════════════


# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  Database (PostgreSQL / TimescaleDB)                                       ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# Name of the PostgreSQL / TimescaleDB database
POSTGRES_DB=ocpp

# PostgreSQL user account
POSTGRES_USER=ocpp

# PostgreSQL password — ⚠ CHANGE THIS IN PRODUCTION ⚠
# Use a strong, randomly generated string (e.g. openssl rand -hex 32)
POSTGRES_PASSWORD=CHANGE_ME_IN_PROD

# Host-mapped port for PostgreSQL (default: 5432)
# Use a different port if 5432 is already in use on the host
POSTGRES_PORT=5432


# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  Redis (Session store, caching, pub/sub)                                   ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# Host-mapped port for Redis (default: 6379)
REDIS_PORT=6379


# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  OpenCPO Core — CSMS Backend (opencpo-core)                                ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# OCPP 1.6 WebSocket port — chargers connect here
# Default: 9100
OCPP_16_WS_PORT=9100

# OCPP 2.0.1 WebSocket port — newer chargers connect here
# Default: 9201
OCPP_201_WS_PORT=9201

# REST API port — admin dashboard and charge app communicate via this API
# Default: 8000
OCPP_API_PORT=8000

# Logging level for the core service
# Allowed values: debug | info | warning | error (case-insensitive)
# Default: INFO
LOG_LEVEL=INFO

# Secret key used for JWT signing, session encryption, and CSRF tokens
# ⚠ CHANGE THIS IN PRODUCTION ⚠
# Generate a strong key:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_IN_PROD

# Public base URL of the platform
#  - Local dev:   http://localhost
#  - Production:  https://charging.yourcompany.com
# Used for QR code generation, email links, and CORS configuration
PUBLIC_URL=http://localhost

# (Internal — override only if you changed the compose service name)
# PostgreSQL hostname inside the Docker network
# PG_HOST=postgres

# (Internal — override only if you changed the compose service name)
# PostgreSQL port inside the Docker network
# PG_PORT=5432

# (Internal — override only if you changed the compose service name)
# Redis hostname inside the Docker network
# REDIS_HOST=redis

# (Internal — override only if you changed the compose service name)
# Redis port inside the Docker network
# REDIS_PORT=6379


# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  OpenCPO Admin — Operator Dashboard (opencpo-admin)                        ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# Port for the CPO (Charge Point Operator) admin web UI
# Default: 8080
CPO_ADMIN_PORT=8080

# Organisation name displayed in the admin dashboard header, reports, and emails
# Default: OpenCPO Demo
ORG_NAME=My CPO

# (Internal — URL of the core API from within the Docker network)
# OCPP_CORE_API=http://ocpp-core:8000


# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  OpenCPO Charge App — Driver PWA (opencpo-charge-app)                      ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# Port for the driver-facing Progressive Web App (PWA)
# Default: 8003
CHARGE_APP_PORT=8003


# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  OpenCPO Tester — Compliance Test Suite (opencpo-tester)                   ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# Port for the OCPP compliance / conformance tester web interface
# Default: 8090
COMPLIANCE_PORT=8090

# (Internal — WebSocket URL the tester connects to)
# DEFAULT_WS_URL=ws://ocpp-core:9100


# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  OpenCPO Charger Farm — Virtual Charger Simulator (opencpo-charger-farm)   ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# Port for the virtual charger farm / simulator web UI
# Default: 8087
CHARGER_FARM_PORT=8087

# (Internal — WebSocket URL for OCPP 1.6 connections)
# OCPP_WS_URL=ws://ocpp-core:9100

# (Internal — WebSocket URL for OCPP 2.0.1 connections)
# OCPP_201_WS_URL=ws://ocpp-core:9201

# (Internal — charger farm UI port, should match CHARGER_FARM_PORT)
# FARM_UI_PORT=8087
